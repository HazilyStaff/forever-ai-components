{
  "name": "forever-components-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Private visual library for the Forever AI Components collection.",
  "engines": { "node": ">=20" },
  "scripts": {
    "catalogue": "node scripts/build-catalogue.mjs",
    "dev": "npm run catalogue && vite",
    "build": "npm run catalogue && tsc --noEmit && vite build && node scripts/copy-components.mjs",
    "preview": "wrangler pages dev dist --port 8788",
    "validate": "node scripts/build-catalogue.mjs --check",
    "sync-report": "node scripts/sync-report.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "minisearch": "^7.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.40.0"
  }
}
